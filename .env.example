ANTHROPIC_API_KEY=
# Appraisals, parsing, and listing drafts. Default claude-haiku-4-5.
ANTHROPIC_MODEL=
# Scam checks. Default claude-sonnet-5-5.
ANTHROPIC_INSPECTOR_MODEL=
# Negotiation and offer lines. Default claude-opus-5-5.
ANTHROPIC_MESSAGE_MODEL=
# low, medium, high, xhigh, or max. Default low.
ANTHROPIC_MESSAGE_EFFORT=
CORS_ORIGINS=http://localhost:5173
DATABASE_PATH=
# Shared Render Postgres. Tables are created only in schema fairlot.
# postgres:// and postgresql:// are both accepted. Unset uses SQLite.
DATABASE_URL=
# Scout reads public marketplace search pages only when this is 1.
# Craigslist SF Bay, eBay local pickup, OfferUp, and Mercari. Facebook
# Marketplace and Nextdoor are skipped because they require sign-in.
SCOUT_LIVE=
# Optional. When set, eBay is read from the public Finding API instead of the
# search page. A 401/403/429 or a CAPTCHA stops that source for the run.
EBAY_APP_ID=
# Seconds between background Scout runs. Default 600.
SCOUT_INTERVAL_S=600
# Seconds between match and negotiation passes. Default 120.
BACKGROUND_INTERVAL_S=120

# Frontend (Person A). Empty means same origin as the API.
VITE_API_BASE_URL=

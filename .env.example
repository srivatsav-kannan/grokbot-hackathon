ANTHROPIC_API_KEY=
# Appraisals, parsing, and listing drafts. Default claude-haiku-4-5.
ANTHROPIC_MODEL=
# Scam checks. Default claude-sonnet-5-5.
ANTHROPIC_INSPECTOR_MODEL=
# Negotiation and offer lines. Default claude-opus-5-5.
ANTHROPIC_MESSAGE_MODEL=
# low, medium, high, xhigh, or max. Default low.
ANTHROPIC_MESSAGE_EFFORT=
CORS_ORIGINS=http://localhost:5173
DATABASE_PATH=
# Scout reads public pages only when this is 1.
SCOUT_LIVE=
# Seconds between background Scout runs. Default 600.
SCOUT_INTERVAL_S=600
# Seconds between match and negotiation passes. Default 120.
BACKGROUND_INTERVAL_S=120

# Frontend (Person A). Empty means same origin as the API.
VITE_API_BASE_URL=
